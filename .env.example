# Server Configuration
PORT=8080
NODE_ENV=development

# Platform API Tokens (optional - for posting comments)
# GITHUB_TOKEN=ghp_your_github_personal_access_token
GITLAB_TOKEN=your_gitlab_token_here
# BITBUCKET_TOKEN=your_bitbucket_app_password

# Platform Hosts (optional - customize if using self-hosted)
GITLAB_HOST=https://gitlab.hmc.co.kr/
# GITHUB_HOST=https://github.com
# BITBUCKET_HOST=https://ade-bitb.hmckmc.co.kr/

# OpenCode AI Configuration
# When using Docker Compose, this is automatically set to http://opencode-server:4096
# For local development without Docker, use: http://localhost:4096
# OPENCODE_API_URL=http://localhost:4096
# OPENCODE_API_KEY=your_opencode_api_key_here