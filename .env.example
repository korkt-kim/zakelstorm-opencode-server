# Server Configuration
# PORT=8080
# NODE_ENV=development

# Platform API Tokens (optional - for posting comments)
# GITHUB_TOKEN=ghp_your_github_personal_access_token
GITLAB_TOKEN=your_gitlab_token_here
# BITBUCKET_TOKEN=your_bitbucket_app_password

# Webhook Secrets (optional - for webhook signature verification)
# GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
# GITLAB_WEBHOOK_SECRET=your_gitlab_webhook_secret
# BITBUCKET_WEBHOOK_SECRET=your_bitbucket_webhook_secret
# OpenCode AI Configuration
# When using Docker Compose, this is automatically set to http://opencode-server:3001
# For local development without Docker, use: http://localhost:3001
# OPENCODE_API_URL=http://localhost:3001
# OPENCODE_API_KEY=your_opencode_api_key_here
# MODEL_PROVIDER=opencode
# MODEL=big-pickle
